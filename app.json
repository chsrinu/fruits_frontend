{
  "expo": {
    "name": "fruits_frontend",
    "slug": "fruits_frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fruitsfrontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "testingOnRealDevice": "http://192.168.29.15:8080",
      "testingOnSimulator": "http://localhost:8080",
      "backendBaseUrl": "http://192.168.29.15:8080"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chsreenivas92.fruits-frontend"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
